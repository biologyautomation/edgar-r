# History files
.Rhistory
.Rapp.history
# Session Data files
.RData
.RDataTmp
# User-specific files
.Ruserdata
# Example code in package build process
*-Ex.R
# Output files from R CMD build
/*.tar.gz
# Output files from R CMD check
/*.Rcheck/
# RStudio files
.Rproj.user/
*.Rproj
.Rd2pdf*/
# RStudio Connect bookmark
rsconnect/
# vscode files
.vscode/
# knitr and rmarkdown intermediate files
**/cache/
**/*/cache/
*.utf8.md
*.knit.md
# Shiny instance files
rsconnect/
# REnviron - may contain API keys
.Renviron
# vignettes output
vignettes/*.html
vignettes/*.pdf
# More extensive .gitignore for R packages:
# https://github.com/github/gitignore/blob/main/R.gitignore
inst/doc
